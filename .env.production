# ─────────────────────────────────────────────────────────────
#  Munwan Car Rental — PRODUCTION environment variables
# ─────────────────────────────────────────────────────────────
#  Copy this file to /opt/munwan/.env on the production server.
#  Replace ALL placeholders before starting docker compose.
#  NEVER commit this file to git.
# ─────────────────────────────────────────────────────────────

# ─── Django core ─────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=REPLACE-WITH-50-CHAR-RANDOM-STRING
DEBUG=False
ALLOWED_HOSTS=munwancarrental.com www.munwancarrental.com
CSRF_TRUSTED_ORIGINS=https://munwancarrental.com,https://www.munwancarrental.com
SITE_URL=https://munwancarrental.com

# ─── PostgreSQL (used by docker-compose) ────────────────────
# These three drive the `db` container creation. The `web` container builds
# DATABASE_URL from them automatically (see docker-compose.yml).
POSTGRES_DB=munwan
POSTGRES_USER=munwan
POSTGRES_PASSWORD=REPLACE-WITH-A-LONG-RANDOM-PASSWORD

# DATABASE_URL is set inside docker-compose.yml — don't override here unless
# you're running web outside docker compose.

# ─── Email (Zoho or Gmail SMTP) ─────────────────────────────
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@munwancarrental.com
EMAIL_HOST_PASSWORD=YOUR-ZOHO-APP-PASSWORD
DEFAULT_FROM_EMAIL=Munwan Car Rental <info@munwancarrental.com>
ADMIN_BOOKING_EMAIL=info@munwancarrental.com

# ─── Paystack (LIVE keys, not test) ─────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE
PAYSTACK_SECRET_KEY=sk_live_REPLACE

# ─── PayPal (LIVE mode) ─────────────────────────────────────
PAYPAL_CLIENT_ID=REPLACE
PAYPAL_SECRET=REPLACE
PAYPAL_MODE=live

# ─── M-Pesa Daraja (PRODUCTION) ─────────────────────────────
MPESA_CONSUMER_KEY=REPLACE
MPESA_CONSUMER_SECRET=REPLACE
MPESA_SHORTCODE=REPLACE
MPESA_PASSKEY=REPLACE
MPESA_CALLBACK_URL=https://munwancarrental.com/payments/mpesa/callback/
MPESA_ENV=production

# ─── Branding ───────────────────────────────────────────────
WHATSAPP_NUMBER=254727745907

# ─── Rate limits ────────────────────────────────────────────
RATE_LIMIT_BOOKING=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WINDOW=3600